# R2G-ETL Environment Configuration
# Copy to .env and edit values. The CLI auto-loads .env from the working directory.
# CLI flags override these values when both are provided.

# PostgreSQL
PG_CONN=postgresql://user:password@localhost:5432/mydb

# ArangoDB
ARANGO_ENDPOINT=http://localhost:8529
ARANGO_DB=_system
ARANGO_USER=root
ARANGO_PASSWORD=

# --- Optional security settings ---

# Fernet key for encrypting credentials in the catalog. When unset, r2g uses
# (or creates) ~/.r2g/secret.key. Generate one with: r2g secrets init
#R2G_SECRET_KEY=

# Bearer token required for /api/* when the Studio UI binds to a non-loopback
# address. Auto-generated and printed at startup if unset.
#R2G_API_TOKEN=

# Comma-separated list of allowed CORS origins for the Studio UI.
# Default: same-origin only.
#R2G_CORS_ORIGINS=

# Confine CSV sources to a trusted directory tree. When set, any CSV source
# directory must resolve to a location inside it (symlinks and .. resolved
# first). Recommended when exposing the UI/MCP server on a shared host.
# Default: unset (any local path allowed).
#R2G_CSV_BASE_DIR=

# The MCP SSE transport reuses R2G_API_TOKEN. Binding it to a non-loopback
# address requires a Bearer token (auto-generated and printed if unset).

# ── Integration tests ────────────────────────────────────────────────────
# These match docker-compose.yml, so `docker compose up -d --wait` plus this
# file is enough to run `pytest tests/integration -m integration`.
MYSQL_CONN=mysql://r2g:r2g_test_2026@localhost:3306/shop
MSSQL_CONN=mssql://sa:r2g_Test_2026!@localhost:1433/shop
# ClickHouse HTTP is published on 8124, not 8123, so it cannot collide with
# another ClickHouse already running locally.
CLICKHOUSE_DSN=clickhouse://r2g:r2g_test_2026@localhost:8124/forge

# ── Federation Forge: Snowflake roundtrip (ADR-0006 D-3) ─────────────────
# No compose service exists for this one — it runs against a real account.
# Auth is SNOWFLAKE_PASSWORD or SNOWFLAKE_PRIVATE_KEY_FILE; the tests skip
# themselves unless ACCOUNT, USER, DATABASE and WAREHOUSE are all present.
# The roundtrip creates and drops one throwaway schema per run
# (R2G_RT_<seed>_<pid>_<hex>), so it needs CREATE SCHEMA on the database —
# which a fabric read-only role such as CDF_RO deliberately does not have.
# SNOWFLAKE_FORGE_ROLE overrides SNOWFLAKE_ROLE for this test alone, so the
# read-only role can stay the default everywhere else.
#SNOWFLAKE_ACCOUNT=
#SNOWFLAKE_USER=
#SNOWFLAKE_PRIVATE_KEY_FILE=
#SNOWFLAKE_WAREHOUSE=CDF_WH
#SNOWFLAKE_DATABASE=CDF_FORGE
#SNOWFLAKE_ROLE=CDF_RO
#SNOWFLAKE_FORGE_ROLE=CDF_FORGE
